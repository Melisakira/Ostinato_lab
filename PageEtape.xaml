<Window x:Class="Ostinato_lab.PageEtape"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Étape" Height="650" Width="950"
        Background="{StaticResource TealFond}"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== NAV LATERALE ===== -->
        <!-- Harmonisation parfaite avec le menu de la page précédente -->
        <Border Grid.Column="0" Background="{StaticResource AmbreFond}">
            <StackPanel Margin="0,20,0,0">
                <TextBlock Text="[ Mon Espace ]" FontWeight="Bold" FontSize="16"
                           Margin="20,0,0,20" Foreground="{StaticResource TealTexteFonce}"/>

                <Button Content="Tableau de bord" Height="40" Margin="10,5"
                        Background="Transparent" Foreground="{StaticResource TealTexteMoyen}" BorderThickness="0"/>

                <!-- BOUTON ACTIF : Reste "Ma Formation" puisque nous naviguons dans un de ses modules -->
                <Button Content="Ma Formation" Height="40" Margin="10,5"
                        Background="{StaticResource StatutActif}" Foreground="White" BorderThickness="0" FontWeight="Bold">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Content="Mes Jalons" Height="40" Margin="10,5"
                        Background="Transparent" Foreground="{StaticResource TealTexteMoyen}" BorderThickness="0" Click="BtnJalons_Click"/>

                <Button Content="Messagerie" Height="40" Margin="10,5"
                        Background="Transparent" Foreground="{StaticResource TealTexteMoyen}" BorderThickness="0"/>

                <!-- MODIFIÉ : Bouton Déconnexion (Gris très clair #F0F0F0 avec fine bordure de structure) -->
                <Button Content="Déconnexion" Height="40" Margin="10,300,10,5"
                        Background="#F0F0F0" BorderBrush="{StaticResource StatutAtteint}" BorderThickness="1" 
                        Foreground="{StaticResource TealTexteFonce}"/>
            </StackPanel>
        </Border>

        <!-- ===== CONTENU PRINCIPAL ===== -->
        <Border Grid.Column="1" Background="{StaticResource TealFond}">
            <StackPanel Margin="30,20,30,0">

                <!-- MODIFIÉ : Bouton Retour au Module 2 (Gris très clair #F0F0F0) -->
                <Button Content="← Retour au Module 2" Foreground="{StaticResource TealTexteFonce}" FontSize="13" 
                        Margin="0,0,0,15" HorizontalAlignment="Left" Background="#F0F0F0" 
                        BorderBrush="{StaticResource StatutAtteint}" BorderThickness="1" Padding="10,2" Cursor="Hand" Click="BtnRetourModule_Click"/>

                <!-- Fil d'ariane module / étape -->
                <TextBlock Text="[Module 2] Notions de base" FontWeight="SemiBold" FontSize="13"
                           Foreground="{StaticResource TealTexteMoyen}"/>
                <TextBlock Text="Étape 2 sur 4" FontSize="12" Foreground="{StaticResource StatutAtteint}" Margin="0,2,0,10"/>

                <Separator Background="{StaticResource StatutAtteint}" Height="1" Margin="0,0,0,15"/>

                <!-- Titre + type -->
                <TextBlock Text="[ TITRE DE LA MICRO-ÉTAPE ]" FontSize="20" FontWeight="Bold" 
                           Foreground="{StaticResource TealTexteFonce}"/>

                <!-- Badge de Type d'étape : Utilisation du ton Ambre pour attirer doucement l'attention sur le contexte -->
                <Border Background="{StaticResource AmbreFond}" CornerRadius="6" Padding="12,4"
                        HorizontalAlignment="Left" Margin="0,8,0,15">
                    <TextBlock Text="Type : Exercice" FontSize="12" FontWeight="SemiBold" 
                               Foreground="{StaticResource AmbreTexteMoyen}"/>
                </Border>

                <!-- Zone de contenu (La carte centrale de travail) -->
                <Border Background="White" BorderBrush="{StaticResource StatutAtteint}" BorderThickness="1"
                        CornerRadius="8" Padding="20" Height="280">
                    <StackPanel>
                        <TextBlock Text="[ CONTENU DE L'ÉTAPE ]" FontWeight="Bold" FontSize="15" 
                                   Foreground="{StaticResource TealTexteFonce}"/>
                        <TextBlock Text="Consigne de l'exercice à réaliser, décrite ici de façon claire et concise."
                                   TextWrapping="Wrap" Foreground="{StaticResource TealTexteFonce}" FontSize="14" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Navigation Bas de page -->
                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- MODIFIÉ : Étape précédente (Gris très clair #F0F0F0) -->
                    <Button Grid.Column="0" Content="← Étape précédente" Width="160" Height="40"
                            HorizontalAlignment="Left" Background="#F0F0F0" 
                            BorderBrush="{StaticResource StatutAtteint}" BorderThickness="1"
                            Foreground="{StaticResource TealTexteFonce}">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <!-- BOUTON D'ACTION CRITIQUE : Seul gros bloc de couleur vive (Vert d'action) -->
                    <Button Grid.Column="1" Content="Commencer l'exercice →" Width="200" Height="40"
                            Background="{StaticResource StatutActif}" Foreground="White" BorderThickness="0" FontWeight="Bold"
                            Click="BtnCommencerExercice_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>

                <TextBlock Text="ℹ Pour une étape de type Lecture ou Vidéo, ce bouton devient « Marquer comme lu → Étape suivante »."
                           FontSize="11" FontStyle="Italic" Foreground="{StaticResource TealTexteMoyen}" Margin="0,12,0,0"/>

            </StackPanel>
        </Border>

    </Grid>
</Window>
