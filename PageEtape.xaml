<Window x:Class="Ostinato_lab.PageEtape"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Étape" Height="650" Width="950"
        Background="White"
        WindowStartupLocation="CenterScreen">

    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== NAV LATERALE ===== -->
        <Border Grid.Column="0" Background="#D9D9D9">
            <StackPanel Margin="0,20,0,0">
                <TextBlock Text="[ Mon Espace ]" FontWeight="Bold" FontSize="16"
                           Margin="20,0,0,20"/>

                <Button Content="Tableau de bord" Height="40" Margin="10,5"
                        Background="#BFBFBF" BorderThickness="0"/>
                <Button Content="Ma Formation" Height="40" Margin="10,5"
                        Background="#A6A6A6" BorderThickness="0" FontWeight="Bold"/>

                <!-- AJOUT DU CLICK POUR LES JALONS -->
                <Button Content="Mes Jalons" Height="40" Margin="10,5"
                        Background="#BFBFBF" BorderThickness="0" Click="BtnJalons_Click"/>

                <Button Content="Messagerie" Height="40" Margin="10,5"
                        Background="#BFBFBF" BorderThickness="0"/>

                <Button Content="Déconnexion" Height="40" Margin="10,300,10,5"
                        Background="#BFBFBF" BorderThickness="0"/>
            </StackPanel>
        </Border>

        <!-- ===== CONTENU PRINCIPAL ===== -->
        <Border Grid.Column="1" Background="#F5F5F5">
            <StackPanel Margin="30,20,30,0">

                <!-- MODIFICATION : Click changé pour BtnRetourModule_Click afin d'aller sur PageFormation -->
                <Button Content="← Retour au Module 2" Foreground="#666666" FontSize="13" 
                        Margin="0,0,0,15" HorizontalAlignment="Left" Background="Transparent" 
                        BorderThickness="0" Cursor="Hand" Click="BtnRetourModule_Click"/>

                <!-- Fil d'ariane module / étape -->
                <TextBlock Text="[Module 2] Notions de base" FontWeight="SemiBold" FontSize="13"
                           Foreground="#555555"/>
                <TextBlock Text="Étape 2 sur 4" FontSize="12" Foreground="#999999" Margin="0,2,0,10"/>

                <Separator Background="#CCCCCC" Margin="0,0,0,15"/>

                <!-- Titre + type -->
                <TextBlock Text="[ TITRE DE LA MICRO-ÉTAPE ]" FontSize="20" FontWeight="Bold"/>
                <Border Background="#E0E0E0" CornerRadius="10" Padding="10,3"
                        HorizontalAlignment="Left" Margin="0,8,0,15">
                    <TextBlock Text="Type : Exercice" FontSize="12" FontWeight="SemiBold"/>
                </Border>

                <!-- Zone de contenu -->
                <Border Background="White" BorderBrush="#CCCCCC" BorderThickness="1"
                        CornerRadius="4" Padding="20" Height="280">
                    <StackPanel>
                        <TextBlock Text="[ CONTENU DE L'ÉTAPE ]" FontWeight="Bold" FontSize="14"/>
                        <TextBlock Text="Consigne de l'exercice à réaliser, décrite ici de façon claire et concise."
                                   TextWrapping="Wrap" Foreground="#555555" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Navigation -->
                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- MODIFICATION : Retrait de l'attribut Click pour qu'il ne fasse plus rien -->
                    <Button Grid.Column="0" Content="← Étape précédente" Width="160" Height="40"
                            HorizontalAlignment="Left" Background="#E0E0E0" BorderThickness="0"/>

                    <!-- AJOUT DU CLICK POUR ALLER VERS LA PAGE TENTATIVE -->
                    <Button Grid.Column="1" Content="Commencer l'exercice →" Width="200" Height="40"
                            Background="#808080" Foreground="White" BorderThickness="0" FontWeight="Bold"
                            Click="BtnCommencerExercice_Click"/>
                </Grid>

                <TextBlock Text="ℹ Pour une étape de type Lecture ou Vidéo, ce bouton devient « Marquer comme lu → Étape suivante »."
                           FontSize="11" FontStyle="Italic" Foreground="#999999" Margin="0,10,0,0"/>

            </StackPanel>
        </Border>

    </Grid>
</Window>
