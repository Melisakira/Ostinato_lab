<Window x:Class="Ostinato_lab.PageFormation"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ma Formation" Height="650" Width="950"
        Background="#1E1E1E">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== NAV LATERALE ===== -->
        <Border Grid.Column="0" Background="#D9D9D9">
            <StackPanel Margin="0,20,0,0">
                <TextBlock Text="[ Mon Espace ]" FontWeight="Bold" FontSize="16"
                           Margin="20,0,0,20" HorizontalAlignment="Left"/>

                <Button Content="Tableau de bord" Height="40" Margin="10,5"
                        Background="#BFBFBF" BorderThickness="0"/>
                <Button Content="Ma Formation" Height="40" Margin="10,5"
                        Background="#A6A6A6" BorderThickness="0" FontWeight="Bold"/>
                <Button Content="Mes Jalons" Height="40" Margin="10,5"
                        Background="#BFBFBF" BorderThickness="0"/>
                <Button Content="Messagerie" Height="40" Margin="10,5"
                        Background="#BFBFBF" BorderThickness="0"/>

                <Button Content="Déconnexion" Height="40" Margin="10,300,10,5"
                        Background="#BFBFBF" BorderThickness="0"/>
            </StackPanel>
        </Border>

        <!-- ===== CONTENU PRINCIPAL ===== -->
        <Grid Grid.Column="1" Background="#F5F5F5" Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Titre formation -->
            <StackPanel Grid.Row="0" Margin="30,25,30,0">
                <TextBlock Text="[ NOM DE LA FORMATION ]" FontSize="26" FontWeight="Bold"/>
                <TextBlock Text="Description courte de la formation et de ses objectifs."
                           FontSize="13" Foreground="#555555" Margin="0,5,0,0"/>
            </StackPanel>

            <Separator Grid.Row="0" Margin="30,80,30,0" Background="#CCCCCC"/>

            <!-- Progression globale et Retour -->
            <StackPanel Grid.Row="1" Margin="30,20,30,0">
                <TextBlock Text="Votre progression globale :" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <Border Height="18" Background="#E0E0E0" CornerRadius="9">
                    <Border HorizontalAlignment="Left" Width="200" Height="18"
                            Background="#808080" CornerRadius="9"/>
                </Border>

                <!-- NOUVEAU BOUTON : Retour à la page d'accueil -->
                <Button Content="← Retour à  la formation " Width="200" Height="32"
                        Margin="0,15,0,0" HorizontalAlignment="Left" Background="#BFBFBF"
                        Foreground="Black" BorderThickness="0" Click="RetourAccueil_Click"/>
            </StackPanel>

            <!-- Liste des modules -->
            <TextBlock Grid.Row="2" Text="Modules :" FontWeight="Bold" FontSize="16"
                       Margin="30,25,30,10"/>

            <ScrollViewer Grid.Row="3" Margin="30,0,30,20" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- Module 1 : terminé -->
                    <Border Background="White" BorderBrush="#CCCCCC" BorderThickness="1"
                            CornerRadius="4" Padding="15" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="✓ [Module 1] Introduction" FontWeight="Bold"/>
                            <TextBlock Text="3/3 micro-étapes complétées"
                                       Foreground="#666666" FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Module 2 : en cours -->
                    <Border Background="White" BorderBrush="#999999" BorderThickness="2"
                            CornerRadius="4" Padding="15" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="▶ [Module 2] Notions de base" FontWeight="Bold"/>
                            <TextBlock Text="1/4 micro-étapes complétées"
                                       Foreground="#666666" FontSize="12" Margin="0,4,0,8"/>

                            <!-- MODIFICATION : Ajout de l'événement Click -->
                            <Button Content="Reprendre ce module" Width="180" Height="32"
                                    HorizontalAlignment="Left" Background="#808080"
                                    Foreground="White" BorderThickness="0" Click="ReprendreModule_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Module 3 : non commencé -->
                    <Border Background="#FAFAFA" BorderBrush="#DDDDDD" BorderThickness="1"
                            CornerRadius="4" Padding="15" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="○ [Module 3] Approfondissement" FontWeight="Bold"
                                       Foreground="#999999"/>
                            <TextBlock Text="Non commencé"
                                       Foreground="#AAAAAA" FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

        </Grid>
        <ListView x:Name="ListeFormations">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Titre" DisplayMemberBinding="{Binding Titre}" Width="200"/>
                    <GridViewColumn Header="Description" DisplayMemberBinding="{Binding Description}" Width="300"/>
                    <GridViewColumn Header="Niveau" DisplayMemberBinding="{Binding Niveau}" Width="100"/>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Window>
