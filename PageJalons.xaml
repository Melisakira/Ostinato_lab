<Window x:Class="Ostinato_lab.PageJalons"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mes Jalons" Height="650" Width="950"
        Background="White"
        WindowStartupLocation="CenterScreen">

    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== NAV LATERALE ===== -->
        <Border Grid.Column="0" Background="{StaticResource AmbreFond}">
            <StackPanel Margin="0,20,0,0">
                <TextBlock Text="[ Mon Espace ]" FontWeight="Bold" FontSize="16"
                   Margin="20,0,0,20" Foreground="{StaticResource TealTexteFonce}"/>

                <Button Content="Tableau de bord" Height="40" Margin="10,5"
                Background="Transparent" Foreground="{StaticResource TealTexteMoyen}" BorderThickness="0"/>
                <Button Content="Ma Formation" Height="40" Margin="10,5"
                Background="Transparent" Foreground="{StaticResource TealTexteMoyen}" BorderThickness="0"/>

                <!-- BOUTON ACTIF -->
                <Button Content="Mes Jalons" Height="40" Margin="10,5"
                Background="{StaticResource StatutActif}" Foreground="White" BorderThickness="0" FontWeight="Bold"/>

                <Button Content="Messagerie" Height="40" Margin="10,5"
                Background="Transparent" Foreground="{StaticResource TealTexteMoyen}" BorderThickness="0" Click="ButtonMessagerie_Click"/>

                <Button Content="Déconnexion" Height="40" Margin="10,300,10,5"
                Background="{StaticResource GrisBouton}" BorderBrush="{StaticResource StatutAtteint}" BorderThickness="1" 
                Foreground="{StaticResource TealTexteFonce}"/>
            </StackPanel>
        </Border>

        <!-- ===== CONTENU PRINCIPAL ===== -->
        <Border Grid.Column="1" Background="{StaticResource TealFond}">
            <StackPanel Margin="30,25,30,0">

                <TextBlock Text="Mes Jalons" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TealTexteFonce}"/>
                <TextBlock Text="[ NOM DE LA FORMATION EN COURS ]" FontSize="13"
                   Foreground="{StaticResource TealTexteMoyen}" Margin="0,4,0,15"/>

                <Separator Background="{StaticResource StatutAtteint}" Height="1" Margin="0,0,0,15"/>

                <!-- Liste des jalons -->
                <StackPanel>

                    <!-- Jalon complété -->
                    <Border Background="White" BorderBrush="{StaticResource StatutAtteint}" BorderThickness="1"
                    CornerRadius="4" Padding="15" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="✓" Foreground="{StaticResource StatutActif}" FontWeight="Bold"
                                   FontSize="16" Width="30" VerticalAlignment="Top"/>
                                <StackPanel>
                                    <TextBlock Text="[Jalon 1] Lire le support de l'étape 1" FontWeight="Bold" 
                                       Foreground="{StaticResource StatutAtteint}" TextDecorations="Strikethrough"/>
                                    <TextBlock Text="Complété" Foreground="{StaticResource StatutActif}" FontSize="12" Margin="0,3,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Jalon à venir 2 -->
                    <Border Background="White" BorderBrush="{StaticResource StatutAtteint}" BorderThickness="1"
                    CornerRadius="4" Padding="15" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="○" Foreground="{StaticResource StatutAtteint}" FontWeight="Bold"
                                   FontSize="16" Width="30" VerticalAlignment="Top"/>
                                <StackPanel>
                                    <TextBlock Text="[Jalon 2] Terminer la première tentative d'exercice" FontWeight="Bold" Foreground="{StaticResource TealTexteFonce}"/>
                                    <TextBlock Text="À venir" Foreground="{StaticResource TealTexteMoyen}" FontSize="12" Margin="0,3,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <Button Grid.Column="1" Content="✎ Recalibrer" Width="110" Height="32"
                            VerticalAlignment="Center" Background="{StaticResource GrisBouton}" 
                            BorderBrush="{StaticResource StatutAtteint}" BorderThickness="1"
                            Foreground="{StaticResource TealTexteFonce}" FontSize="12"/>
                        </Grid>
                    </Border>

                    <!-- Jalon à venir 3 -->
                    <Border Background="White" BorderBrush="{StaticResource StatutAtteint}" BorderThickness="1"
                    CornerRadius="4" Padding="15" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="○" Foreground="{StaticResource StatutAtteint}" FontWeight="Bold"
                                   FontSize="16" Width="30" VerticalAlignment="Top"/>
                                <StackPanel>
                                    <TextBlock Text="[Jalon 3] Envoyer un message de validation au formateur" FontWeight="Bold" Foreground="{StaticResource TealTexteFonce}"/>
                                    <TextBlock Text="À venir" Foreground="{StaticResource TealTexteMoyen}" FontSize="12" Margin="0,3,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <Button Grid.Column="1" Content="✎ Recalibrer" Width="110" Height="32"
                            VerticalAlignment="Center" Background="{StaticResource GrisBouton}" 
                            BorderBrush="{StaticResource StatutAtteint}" BorderThickness="1"
                            Foreground="{StaticResource TealTexteFonce}" FontSize="12"/>
                        </Grid>
                    </Border>

                    <!-- Jalon à venir 4 -->
                    <Border Background="White" BorderBrush="{StaticResource StatutAtteint}" BorderThickness="1"
                    CornerRadius="4" Padding="15" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="○" Foreground="{StaticResource StatutAtteint}" FontWeight="Bold"
                                   FontSize="16" Width="30" VerticalAlignment="Top"/>
                                <StackPanel>
                                    <TextBlock Text="[Jalon 4] Terminer le module 2" FontWeight="Bold" Foreground="{StaticResource TealTexteFonce}"/>
                                    <TextBlock Text="À venir" Foreground="{StaticResource TealTexteMoyen}" FontSize="12" Margin="0,3,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <Button Grid.Column="1" Content="✎ Recalibrer" Width="110" Height="32"
                            VerticalAlignment="Center" Background="{StaticResource GrisBouton}" 
                            BorderBrush="{StaticResource StatutAtteint}" BorderThickness="1"
                            Foreground="{StaticResource TealTexteFonce}" FontSize="12"/>
                        </Grid>
                    </Border>

                </StackPanel>

                <!-- Note informative -->
                <Border Background="{StaticResource AmbreFond}" CornerRadius="4" Padding="12" Margin="0,10,0,20">
                    <TextBlock TextWrapping="Wrap" FontStyle="Italic" FontSize="12" Foreground="{StaticResource AmbreTexteMoyen}">
                <Run Text="ℹ Vos jalons sont recalibrables à tout moment depuis cet écran."/>
                    </TextBlock>
                </Border>
            </StackPanel>
        </Border>


    </Grid>
</Window>
