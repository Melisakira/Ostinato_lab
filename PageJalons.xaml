<Window x:Class="Ostinato_lab.PageJalons"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mes Jalons" Height="650" Width="950"
        Background="White"
        WindowStartupLocation="CenterScreen">

    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== NAV LATERALE ===== -->
        <Border Grid.Column="0" Background="#D9D9D9">
            <StackPanel Margin="0,20,0,0">
                <TextBlock Text="[ Mon Espace ]" FontWeight="Bold" FontSize="16"
                           Margin="20,0,0,20"/>

                <Button Content="Tableau de bord" Height="40" Margin="10,5"
                        Background="#BFBFBF" BorderThickness="0"/>
                <Button Content="Ma Formation" Height="40" Margin="10,5"
                        Background="#BFBFBF" BorderThickness="0"/>
                <Button Content="Mes Jalons" Height="40" Margin="10,5"
                        Background="#A6A6A6" BorderThickness="0" FontWeight="Bold"/>

                <!-- AJOUT DU CLICK SUR MESSAGERIE -->
                <Button Content="Messagerie" Height="40" Margin="10,5"
                        Background="#BFBFBF" BorderThickness="0" Click="BtnMessagerie_Click"/>

                <Button Content="Déconnexion" Height="40" Margin="10,300,10,5"
                        Background="#BFBFBF" BorderThickness="0"/>
            </StackPanel>
        </Border>

        <!-- ===== CONTENU PRINCIPAL ===== -->
        <Border Grid.Column="1" Background="#F5F5F5">
            <StackPanel Margin="30,25,30,0">

                <TextBlock Text="Mes Jalons" FontSize="24" FontWeight="Bold"/>
                <TextBlock Text="[ NOM DE LA FORMATION EN COURS ]" FontSize="13"
                           Foreground="#666666" Margin="0,4,0,15"/>

                <Separator Background="#CCCCCC" Margin="0,0,0,15"/>

                <!-- Liste des jalons : LECTURE SEULE -->
                <StackPanel>

                    <Border Background="White" BorderBrush="#CCCCCC" BorderThickness="1"
                            CornerRadius="4" Padding="15" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✓" Foreground="#2E7D32" FontWeight="Bold"
                                       FontSize="16" Width="30" VerticalAlignment="Top"/>
                            <StackPanel>
                                <TextBlock Text="[Jalon 1] Lire le support de l'étape 1" FontWeight="Bold"/>
                                <TextBlock Text="Complété" Foreground="#2E7D32" FontSize="12" Margin="0,3,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="White" BorderBrush="#CCCCCC" BorderThickness="1"
                            CornerRadius="4" Padding="15" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="○" Foreground="#999999" FontWeight="Bold"
                                       FontSize="16" Width="30" VerticalAlignment="Top"/>
                            <StackPanel>
                                <TextBlock Text="[Jalon 2] Terminer la première tentative d'exercice" FontWeight="Bold"/>
                                <TextBlock Text="À venir" Foreground="#999999" FontSize="12" Margin="0,3,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="White" BorderBrush="#CCCCCC" BorderThickness="1"
                            CornerRadius="4" Padding="15" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="○" Foreground="#999999" FontWeight="Bold"
                                       FontSize="16" Width="30" VerticalAlignment="Top"/>
                            <StackPanel>
                                <TextBlock Text="[Jalon 3] Envoyer un message de validation au formateur" FontWeight="Bold"/>
                                <TextBlock Text="À venir" Foreground="#999999" FontSize="12" Margin="0,3,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="White" BorderBrush="#CCCCCC" BorderThickness="1"
                            CornerRadius="4" Padding="15" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="○" Foreground="#999999" FontWeight="Bold"
                                       FontSize="16" Width="30" VerticalAlignment="Top"/>
                            <StackPanel>
                                <TextBlock Text="[Jalon 4] Terminer le module 2" FontWeight="Bold"/>
                                <TextBlock Text="À venir" Foreground="#999999" FontSize="12" Margin="0,3,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- Note informative -->
                <Border Background="#EAEAEA" CornerRadius="4" Padding="12" Margin="0,10,0,20">
                    <TextBlock TextWrapping="Wrap" FontStyle="Italic" FontSize="12" Foreground="#555555">
                        <Run Text="ℹ Vos jalons évoluent automatiquement selon votre progression. "/>
                        <Run Text="Aucune action de votre part n'est requise ici."/>
                    </TextBlock>
                </Border>

            </StackPanel>
        </Border>

    </Grid>
</Window>
