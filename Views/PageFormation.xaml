<Window x:Class="Ostinato_lab.Views.PageFormation"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ma Formation" Height="650" Width="950"
        Background="{StaticResource TealFond}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== NAV LATERALE ===== -->
        <Border Grid.Column="0" Background="{StaticResource AmbreFond}">
            <StackPanel Margin="0,20,0,0">
                <TextBlock Text="[ Mon Espace ]" FontWeight="Bold" FontSize="16"
                           Margin="20,0,0,20" HorizontalAlignment="Left"
                           Foreground="{StaticResource TealTexteFonce}"/>

                <Button Content="Tableau de bord" Height="40" Margin="10,5"
                        Background="Transparent" Foreground="{StaticResource TealTexteMoyen}" BorderThickness="0"/>

                <Button Content="Ma Formation" Height="40" Margin="10,5"
                        Background="{StaticResource StatutActif}" Foreground="White" BorderThickness="0" FontWeight="Bold">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Content="Mes Jalons" Height="40" Margin="10,5"
                        Background="Transparent" Foreground="{StaticResource TealTexteMoyen}" BorderThickness="0"/>
                <Button Content="Messagerie" Height="40" Margin="10,5"
                        Background="Transparent" Foreground="{StaticResource TealTexteMoyen}" BorderThickness="0"/>

                <Button Content="Déconnexion" Height="40" Margin="10,300,10,5"
                        Background="{StaticResource GrisBouton}" BorderBrush="{StaticResource StatutAtteint}" BorderThickness="1" 
                        Foreground="{StaticResource TealTexteFonce}"/>
            </StackPanel>
        </Border>

        <!-- ===== CONTENU PRINCIPAL ===== -->
        <Grid Grid.Column="1" Background="{StaticResource TealFond}" Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Titre formation -->
            <StackPanel Grid.Row="0" Margin="30,25,30,0">
                <TextBlock Text="[ NOM DE LA FORMATION ]" FontSize="26" FontWeight="Bold" 
                           Foreground="{StaticResource TealTexteFonce}"/>
                <TextBlock Text="Description courte de la formation et de ses objectifs."
                           FontSize="13" Foreground="{StaticResource TealTexteMoyen}" Margin="0,5,0,0"/>
            </StackPanel>

            <!-- Séparateur discret -->
            <Separator Grid.Row="0" Margin="30,80,30,0" Background="{StaticResource StatutAtteint}" Height="1"/>

            <!-- Progression globale et Retour -->
            <StackPanel Grid.Row="1" Margin="30,20,30,0">
                <TextBlock Text="Votre progression globale :" Foreground="{StaticResource TealTexteFonce}" FontWeight="SemiBold" Margin="0,0,0,5"/>

                <Border Height="18" Background="{StaticResource StatutAtteint}" CornerRadius="9">
                    <Border HorizontalAlignment="Left" Width="200" Height="18"
                            Background="{StaticResource StatutActif}" CornerRadius="9"/>
                </Border>

                <Button Content="← Retour à la formation" Width="200" Height="32"
                        Margin="0,15,0,0" HorizontalAlignment="Left" Background="Transparent"
                        Foreground="{StaticResource TealTexteMoyen}" BorderBrush="{StaticResource TealTexteMoyen}" 
                        BorderThickness="1" Click="RetourAccueil_Click"/>
            </StackPanel>

            <!-- Liste des modules -->
            <TextBlock Grid.Row="2" Text="Modules :" FontWeight="Bold" FontSize="16"
                       Foreground="{StaticResource TealTexteFonce}" Margin="30,25,30,10"/>

            <ScrollViewer Grid.Row="3" Margin="30,0,30,20" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Module 1 : Terminé -->
                    <Border Background="White" BorderBrush="{StaticResource StatutAtteint}" BorderThickness="1"
                            CornerRadius="6" Padding="15" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="✓ [Module 1] Introduction" FontWeight="Bold" 
                                       Foreground="{StaticResource StatutAtteint}" TextDecorations="Strikethrough"/>
                            <TextBlock Text="3/3 micro-étapes complétées"
                                       Foreground="{StaticResource StatutAtteint}" FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Module 2 : En cours -->
                    <Border Background="White" BorderBrush="{StaticResource StatutActif}" BorderThickness="2"
                            CornerRadius="6" Padding="15" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="▶ [Module 2] Notions de base" FontWeight="Bold" 
                                       Foreground="{StaticResource TealTexteFonce}"/>
                            <TextBlock Text="1/4 micro-étapes complétées"
                                       Foreground="{StaticResource TealTexteMoyen}" FontSize="12" Margin="0,4,0,8"/>

                            <Button Content="Reprendre ce module" Width="180" Height="32"
                                    HorizontalAlignment="Left" Background="{StaticResource StatutActif}"
                                    Foreground="White" FontWeight="Bold" BorderThickness="0" Click="ReprendreModule_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Module 3 : Non commencé -->
                    <Border Background="{StaticResource AmbreFond}" BorderBrush="{StaticResource StatutAtteint}" BorderThickness="1"
                            CornerRadius="6" Padding="15" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="○ [Module 3] Approfondissement" FontWeight="Bold"
                                       Foreground="{StaticResource TealTexteFonce}"/>
                            <TextBlock Text="0/5 micro-étapes complétées"
                                       Foreground="{StaticResource TealTexteMoyen}" FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
