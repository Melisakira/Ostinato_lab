<Window x:Class="Ostinato_lab.PageTentative"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tentative" Height="650" Width="950"
        Background="{StaticResource TealFond}"
        WindowStartupLocation="CenterScreen">

    <Grid Background="{StaticResource TealFond}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== NAV LATERALE ===== -->
        <Border Grid.Column="0" Background="{StaticResource AmbreFond}">
            <StackPanel Margin="0,20,0,0">
                <TextBlock Text="[ Mon Espace ]" FontWeight="Bold" FontSize="16"
                           Margin="20,0,0,20" Foreground="{StaticResource TealTexteFonce}"/>

                <Button Content="Tableau de bord" Height="40" Margin="10,5"
                        Background="Transparent" Foreground="{StaticResource TealTexteMoyen}" BorderThickness="0"/>

                <!-- BOUTON ACTIF -->
                <Button Content="Ma Formation" Height="40" Margin="10,5"
                        Background="{StaticResource StatutActif}" Foreground="White" BorderThickness="0" FontWeight="Bold"/>

                <Button Content="Mes Jalons" Height="40" Margin="10,5"
                        Background="Transparent" Foreground="{StaticResource TealTexteMoyen}" BorderThickness="0" Click="BtnMesJalons_Click"/>

                <Button Content="Messagerie" Height="40" Margin="10,5"
                        Background="Transparent" Foreground="{StaticResource TealTexteMoyen}" BorderThickness="0"/>

                <Button Content="Déconnexion" Height="40" Margin="10,300,10,5"
                        Background="{StaticResource GrisBouton}" BorderBrush="{StaticResource StatutAtteint}" BorderThickness="1" 
                        Foreground="{StaticResource TealTexteFonce}"/>
            </StackPanel>
        </Border>

        <!-- ===== CONTENU PRINCIPAL ===== -->
        <Border Grid.Column="1" Background="{StaticResource TealFond}">
            <StackPanel Margin="30,20,30,0">

                <!-- Bouton Retour : Harmonisé avec GrisBouton -->
                <Button Content="← Retour à l'étape" Foreground="{StaticResource TealTexteFonce}" FontSize="13" 
                        Margin="0,0,0,15" HorizontalAlignment="Left" Background="{StaticResource GrisBouton}" 
                        BorderBrush="{StaticResource StatutAtteint}" BorderThickness="1" Padding="10,2" Cursor="Hand" Click="BtnRetourEtape_Click"/>

                <!-- Fil d'ariane -->
                <TextBlock Text="[Module 2] Notions de base — Étape 2" FontWeight="SemiBold"
                           FontSize="13" Foreground="{StaticResource TealTexteMoyen}"/>
                <TextBlock Text="Tentative n°1" FontSize="12" Foreground="{StaticResource StatutAtteint}" Margin="0,2,0,10"/>

                <Separator Background="{StaticResource StatutAtteint}" Height="1" Margin="0,0,0,15"/>

                <!-- Titre exercice -->
                <TextBlock Text="[ TITRE DE L'EXERCICE ]" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TealTexteFonce}" Margin="0,0,0,15"/>

                <!-- Zone de réponse -->
                <Border Background="White" BorderBrush="{StaticResource StatutAtteint}" BorderThickness="1"
                        CornerRadius="4" Padding="20" Height="220">
                    <StackPanel>
                        <TextBlock Text="[ ZONE DE RÉPONSE / ACTIVITÉ ]" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TealTexteFonce}"/>
                        <TextBlock Text="Champ de saisie, choix multiple ou zone interactive selon le type d'exercice."
                                   TextWrapping="Wrap" Foreground="{StaticResource TealTexteFonce}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Historique des tentatives : Ambre doux pour un contexte clair et rassurant -->
                <TextBlock Text="Historique des tentatives :" FontWeight="SemiBold" Foreground="{StaticResource TealTexteFonce}"
                           Margin="0,20,0,8"/>
                <Border Background="{StaticResource AmbreFond}" CornerRadius="4" Padding="12">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="●" Foreground="{StaticResource AmbreTexteMoyen}" Width="20"/>
                        <TextBlock Text="Tentative 1 — en cours" Foreground="{StaticResource TealTexteFonce}"/>
                    </StackPanel>
                </Border>

                <!-- Actions -->
                <Grid Margin="0,25,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Annuler : Bouton secondaire en GrisBouton -->
                    <Button Grid.Column="0" Content="Annuler" Width="140" Height="40"
                            HorizontalAlignment="Left" Background="{StaticResource GrisBouton}" 
                            BorderBrush="{StaticResource StatutAtteint}" BorderThickness="1"
                            Foreground="{StaticResource TealTexteFonce}" Click="BtnRetourEtape_Click"/>

                    <!-- Action principale : Focus attentionnel fort en Vert Actif -->
                    <Button Grid.Column="1" Content="Valider ma tentative" Width="200" Height="40"
                            Background="{StaticResource StatutActif}" Foreground="White" BorderThickness="0" FontWeight="Bold"/>
                </Grid>

            </StackPanel>
        </Border>

    </Grid>
</Window>
