<Window x:Class="Ostinato_lab.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Ostinato_lab.Views"
        mc:Ignorable="d"
        Title="MainWindow" Height="650" Width="950">

    <!-- Fond général de la fenêtre passant sur votre couleur de fond principale douce -->
    <Grid Background="{StaticResource TealFond}">
        <!-- Division de l'écran en deux colonnes équitables -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- COLONNE GAUCHE : Zone de calme visuel -->
        <!-- Remplacement du gris terne par le ton chaleureux et rassurant AmbreFond -->
        <Border Grid.Column="0" Background="{StaticResource AmbreFond}" CornerRadius="12" Margin="25">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                <!-- Emplacement du logo Ostinato (Utilisation de votre couleur sombre pour l'icône) -->
                <Rectangle Width="100" Height="100" Fill="{StaticResource TealTexteFonce}" Margin="10">
                    <Rectangle.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Rectangle.Resources>
                </Rectangle>

                <TextBlock Text="[ LOGO OSTINATO ]" HorizontalAlignment="Center" FontWeight="Bold" 
                           Foreground="{StaticResource TealTexteFonce}" FontSize="18"/>

                <TextBlock Text="Votre espace d'apprentissage sans distraction" Margin="0,20,0,0" 
                           Foreground="{StaticResource AmbreTexteMoyen}" HorizontalAlignment="Center" FontSize="14"
                           TextWrapping="Wrap" TextAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- COLONNE DROITE : Formulaire sécurisant -->
        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Width="340" Margin="50,0,0,0">

            <TextBlock Text="Connexion" FontSize="28" FontWeight="Bold" 
                       Foreground="{StaticResource TealTexteFonce}" Margin="0,0,0,25"/>

            <!-- Sélecteur de profil pour rassurer l'utilisateur -->
            <TextBlock Text="Je suis :" Margin="0,0,0,5" Foreground="{StaticResource TealTexteMoyen}" FontWeight="Bold" FontSize="14"/>
            <ComboBox x:Name="ProfilSelect" Height="38" Margin="0,0,0,20" VerticalContentAlignment="Center" Background="White" BorderBrush="{StaticResource StatutAtteint}">
                <ComboBoxItem Content="Un apprenant" IsSelected="True"/>
                <ComboBoxItem Content="Un formateur"/>
                <ComboBoxItem Content="Un administrateur"/>
            </ComboBox>

            <!-- Champ Identifiant -->
            <TextBlock Text="Identifiant ou Email :" Margin="0,0,0,5" Foreground="{StaticResource TealTexteMoyen}" FontSize="13"/>
            <TextBox Height="38" Background="White" BorderBrush="{StaticResource StatutAtteint}" BorderThickness="1.5" 
                     VerticalContentAlignment="Center" Margin="0,0,0,15" SelectionBrush="{StaticResource StatutActif}"/>

            <!-- Champ Mot de passe -->
            <TextBlock Text="Mot de passe :" Margin="0,0,0,5" Foreground="{StaticResource TealTexteMoyen}" FontSize="13"/>
            <PasswordBox Height="38" Background="White" BorderBrush="{StaticResource StatutAtteint}" BorderThickness="1.5" 
                         VerticalContentAlignment="Center" Margin="0,0,0,25" SelectionBrush="{StaticResource StatutActif}"/>

            <!-- Bouton large, facile à cibler sans stress (Vert d'action principal) -->
            <Button Content="Entrer dans mon espace" Height="45" 
                    Background="{StaticResource StatutActif}" Foreground="White" 
                    FontWeight="Bold" FontSize="15" BorderThickness="0" Click="BtnConnexion_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>

        </StackPanel>
    </Grid>
</Window>
