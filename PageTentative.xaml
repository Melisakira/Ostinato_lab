<Window x:Class="Ostinato_lab.PageTentative"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tentative" Height="650" Width="950"
        Background="White"
        WindowStartupLocation="CenterScreen">

    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== NAV LATERALE ===== -->
        <Border Grid.Column="0" Background="#D9D9D9">
            <StackPanel Margin="0,20,0,0">
                <TextBlock Text="[ Mon Espace ]" FontWeight="Bold" FontSize="16"
                           Margin="20,0,0,20"/>

                <Button Content="Tableau de bord" Height="40" Margin="10,5"
                        Background="#BFBFBF" BorderThickness="0"/>
                <Button Content="Ma Formation" Height="40" Margin="10,5"
                        Background="#A6A6A6" BorderThickness="0" FontWeight="Bold"/>

                <!-- CLICK AJOUTÉ ICI POUR ALLER VERS PAGEJALONS -->
                <Button Content="Mes Jalons" Height="40" Margin="10,5"
                        Background="#BFBFBF" BorderThickness="0" Click="BtnMesJalons_Click"/>

                <Button Content="Messagerie" Height="40" Margin="10,5"
                        Background="#BFBFBF" BorderThickness="0"/>

                <Button Content="Déconnexion" Height="40" Margin="10,300,10,5"
                        Background="#BFBFBF" BorderThickness="0"/>
            </StackPanel>
        </Border>

        <!-- ===== CONTENU PRINCIPAL ===== -->
        <Border Grid.Column="1" Background="#F5F5F5">
            <StackPanel Margin="30,20,30,0">

                <!-- TRANSFORMÉ EN BOUTON LIEN POUR ALLER VERS PAGEETAPE -->
                <Button Content="← Retour à l'étape" Foreground="#666666" FontSize="13" 
                        Margin="0,0,0,15" HorizontalAlignment="Left" Background="Transparent" 
                        BorderThickness="0" Cursor="Hand" Click="BtnRetourEtape_Click"/>

                <!-- Fil d'ariane -->
                <TextBlock Text="[Module 2] Notions de base — Étape 2" FontWeight="SemiBold"
                           FontSize="13" Foreground="#555555"/>
                <TextBlock Text="Tentative n°1" FontSize="12" Foreground="#999999" Margin="0,2,0,10"/>

                <Separator Background="#CCCCCC" Margin="0,0,0,15"/>

                <!-- Titre exercice -->
                <TextBlock Text="[ TITRE DE L'EXERCICE ]" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

                <!-- Zone de réponse -->
                <Border Background="White" BorderBrush="#CCCCCC" BorderThickness="1"
                        CornerRadius="4" Padding="20" Height="220">
                    <StackPanel>
                        <TextBlock Text="[ ZONE DE RÉPONSE / ACTIVITÉ ]" FontWeight="Bold" FontSize="14"/>
                        <TextBlock Text="Champ de saisie, choix multiple ou zone interactive selon le type d'exercice."
                                   TextWrapping="Wrap" Foreground="#555555" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Historique des tentatives -->
                <TextBlock Text="Historique des tentatives :" FontWeight="SemiBold"
                           Margin="0,20,0,8"/>
                <Border Background="#EAEAEA" CornerRadius="4" Padding="12">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="●" Foreground="#808080" Width="20"/>
                        <TextBlock Text="Tentative 1 — en cours" Foreground="#555555"/>
                    </StackPanel>
                </Border>

                <!-- Actions -->
                <Grid Margin="0,25,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- ANNULER RETOURNE AUSSI À L'ÉTAPE -->
                    <Button Grid.Column="0" Content="Annuler" Width="140" Height="40"
                            HorizontalAlignment="Left" Background="#E0E0E0" BorderThickness="0"
                            Click="BtnRetourEtape_Click"/>

                    <Button Grid.Column="1" Content="Valider ma tentative" Width="200" Height="40"
                            Background="#808080" Foreground="White" BorderThickness="0" FontWeight="Bold"/>
                </Grid>

            </StackPanel>
        </Border>

    </Grid>
</Window>

