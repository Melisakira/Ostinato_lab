<Window x:Class="Ostinato_lab.TableauDeBord"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tableau de bord" Height="650" Width="950"
        Background="White"
        WindowStartupLocation="CenterScreen">

    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== NAV LATERALE ===== -->
        <Border Grid.Column="0" Background="#D9D9D9">
            <StackPanel Margin="0,20,0,0">
                <TextBlock Text="[ Mon Espace ]" FontWeight="Bold" FontSize="16"
                           Margin="20,0,0,20"/>

                <Button Content="Tableau de bord" Height="40" Margin="10,5"
                        Background="#A6A6A6" BorderThickness="0" FontWeight="Bold"/>

                <!-- MODIFICATION : Ajout de l'événement Click pour aller sur PageFormation -->
                <Button Content="Ma Formation" Height="40" Margin="10,5"
                        Background="#BFBFBF" BorderThickness="0" Click="BtnMaFormation_Click"/>

                <Button Content="Mes Jalons" Height="40" Margin="10,5"
                        Background="#BFBFBF" BorderThickness="0"/>
                <Button Content="Messagerie" Height="40" Margin="10,5"
                        Background="#BFBFBF" BorderThickness="0"/>

                <Button Content="Déconnexion" Height="40" Margin="10,300,10,5"
                        Background="#BFBFBF" BorderThickness="0"/>
            </StackPanel>
        </Border>

        <!-- ===== CONTENU PRINCIPAL ===== -->
        <Border Grid.Column="1" Background="#F5F5F5">
            <!-- La Grid principale permet de caler le contenu en haut et les boutons tout en bas -->
            <Grid>
                <StackPanel Margin="30,25,30,0" VerticalAlignment="Top">

                    <TextBlock Text="Bonjour, Apprenant" FontSize="24" FontWeight="Bold"/>

                    <Border Background="#EAEAEA" CornerRadius="4" Padding="12" Margin="0,15,0,0">
                        <TextBlock TextWrapping="Wrap" FontStyle="Italic">
                            <Run Text="💡 Impulsion bienveillante : "/>
                            <Run Text="Prêt à avancer à votre rythme aujourd'hui ? Pas de pression, chaque petit pas compte."/>
                        </TextBlock>
                    </Border>

                    <TextBlock Text="Formation Active" FontWeight="Bold" FontSize="14"
                               Margin="0,25,0,5" Foreground="#555555"/>

                    <!-- Cadre blanc de la formation (sans les boutons géants à l'intérieur) -->
                    <Border Background="White" BorderBrush="#CCCCCC" BorderThickness="1"
                            CornerRadius="4" Padding="20">
                        <StackPanel>
                            <TextBlock Text="[ NOM DE LA FORMATION EN COURS ]" FontSize="18" FontWeight="Bold"/>

                            <TextBlock Text="Votre progression globale :" Margin="0,15,0,5"/>
                            <Border Height="18" Background="#E0E0E0" CornerRadius="9">
                                <Border HorizontalAlignment="Left" Width="200" Height="18"
                                        Background="#808080" CornerRadius="9"/>
                            </Border>

                            <TextBlock Text="Prochains jalons :" FontWeight="SemiBold" Margin="0,20,0,8"/>

                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="✓" Foreground="#2E7D32" FontWeight="Bold" Width="20"/>
                                <TextBlock Text="[Jalon 1] Lire le support de l'étape 1"
                                           Foreground="#666666" TextDecorations="Strikethrough"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="○" Foreground="#999999" FontWeight="Bold" Width="20"/>
                                <TextBlock Text="[Jalon 2] Terminer la première tentative d'exercice"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="○" Foreground="#999999" FontWeight="Bold" Width="20"/>
                                <TextBlock Text="[Jalon 3] Envoyer un message de validation au formateur"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Les deux boutons sortis du cadre et placés aux extrémités tout en bas de la zone grise -->
                <Grid VerticalAlignment="Bottom" Margin="30,0,30,25">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Inchangé -->
                    <Button Grid.Column="0" Content="Retour à la page d'accueil" HorizontalAlignment="Left"
                            Height="42" Width="200" Background="#505050" Foreground="White" FontWeight="Bold" BorderThickness="0" 
                            Click="BtnRetour_Click"/>

                    <!-- Gardé l'événement BtnVersEtape_Click (qui ouvrira PageFormation dans le C#) -->
                    <Button Grid.Column="1" Content="Reprendre là où j'en étais" HorizontalAlignment="Left"
                            Height="42" Width="200" Background="#A0A0A0" Foreground="White" FontWeight="Bold" BorderThickness="0" 
                            Click="BtnVersEtape_Click" Margin="135,0,0,0"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
