<Window x:Class="Ostinato_lab.TableauDeBord"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tableau de bord" Height="650" Width="950"
        Background="{StaticResource TealFond}"
        WindowStartupLocation="CenterScreen">

    <Grid Background="{StaticResource TealFond}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== NAV LATERALE ===== -->
        <Border Grid.Column="0" Background="{StaticResource AmbreFond}">
            <StackPanel Margin="0,20,0,0">
                <TextBlock Text="[ Mon Espace ]" FontWeight="Bold" FontSize="16"
                           Margin="20,0,0,20" Foreground="{StaticResource TealTexteFonce}"/>

                <!-- BOUTON ACTIF : Tableau de bord prend la couleur focus -->
                <Button Content="Tableau de bord" Height="40" Margin="10,5"
                        Background="{StaticResource StatutActif}" Foreground="White" BorderThickness="0" FontWeight="Bold"/>

                <Button Content="Ma Formation" Height="40" Margin="10,5"
                        Background="Transparent" Foreground="{StaticResource TealTexteMoyen}" BorderThickness="0" Click="BtnMaFormation_Click"/>

                <Button Content="Mes Jalons" Height="40" Margin="10,5"
                        Background="Transparent" Foreground="{StaticResource TealTexteMoyen}" BorderThickness="0"/>
                <Button Content="Messagerie" Height="40" Margin="10,5"
                        Background="Transparent" Foreground="{StaticResource TealTexteMoyen}" BorderThickness="0"/>

                <Button Content="Déconnexion" Height="40" Margin="10,300,10,5"
                        Background="{StaticResource GrisBouton}" BorderBrush="{StaticResource StatutAtteint}" BorderThickness="1" 
                        Foreground="{StaticResource TealTexteFonce}"/>
            </StackPanel>
        </Border>

        <!-- ===== CONTENU PRINCIPAL ===== -->
        <Border Grid.Column="1" Background="{StaticResource TealFond}">
            <Grid>
                <StackPanel Margin="30,25,30,0" VerticalAlignment="Top">

                    <TextBlock Text="Bonjour, Apprenant" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TealTexteFonce}"/>

                    <!-- Impulsion bienveillante : Habillage Ambre anti-stress -->
                    <Border Background="{StaticResource AmbreFond}" CornerRadius="4" Padding="12" Margin="0,15,0,0">
                        <TextBlock TextWrapping="Wrap" FontStyle="Italic" Foreground="{StaticResource AmbreTexteMoyen}">
                            <Run Text="💡 Impulsion bienveillante : " FontWeight="Bold"/>
                            <Run Text="Prêt à avancer à votre rythme aujourd'hui ? Pas de pression, chaque petit pas compte."/>
                        </TextBlock>
                    </Border>

                    <TextBlock Text="Formation Active" FontWeight="Bold" FontSize="14"
                               Margin="0,25,0,5" Foreground="{StaticResource TealTexteMoyen}"/>

                    <!-- Cadre blanc de la formation -->
                    <Border Background="White" BorderBrush="{StaticResource StatutAtteint}" BorderThickness="1"
                            CornerRadius="4" Padding="20">
                        <StackPanel>
                            <TextBlock Text="[ NOM DE LA FORMATION EN COURS ]" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TealTexteFonce}"/>

                            <TextBlock Text="Votre progression globale :" Margin="0,15,0,5" Foreground="{StaticResource TealTexteMoyen}"/>
                            <Border Height="18" Background="{StaticResource StatutAtteint}" CornerRadius="9">
                                <Border HorizontalAlignment="Left" Width="200" Height="18"
                                        Background="{StaticResource StatutActif}" CornerRadius="9"/>
                            </Border>

                            <TextBlock Text="Prochains jalons :" FontWeight="SemiBold" Margin="0,20,0,8" Foreground="{StaticResource TealTexteFonce}"/>

                            <!-- Jalon 1 : Terminé -->
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="✓" Foreground="{StaticResource StatutActif}" FontWeight="Bold" Width="20"/>
                                <TextBlock Text="[Jalon 1] Lire le support de l'étape 1"
                                           Foreground="{StaticResource StatutAtteint}" TextDecorations="Strikethrough"/>
                            </StackPanel>

                            <!-- Jalon 2 : À venir -->
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="○" Foreground="{StaticResource StatutAtteint}" FontWeight="Bold" Width="20"/>
                                <TextBlock Text="[Jalon 2] Terminer la première tentative d'exercice" Foreground="{StaticResource TealTexteFonce}"/>
                            </StackPanel>

                            <!-- Jalon 3 : À venir -->
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="○" Foreground="{StaticResource StatutAtteint}" FontWeight="Bold" Width="20"/>
                                <TextBlock Text="[Jalon 3] Envoyer un message de validation au formateur" Foreground="{StaticResource TealTexteFonce}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Actions du bas -->
                <Grid VerticalAlignment="Bottom" Margin="30,0,30,25">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Retour : Bouton secondaire en GrisBouton -->
                    <Button Grid.Column="0" Content="Retour à la page d'accueil" HorizontalAlignment="Left"
                            Height="42" Width="200" Background="{StaticResource GrisBouton}" 
                            BorderBrush="{StaticResource StatutAtteint}" BorderThickness="1"
                            Foreground="{StaticResource TealTexteFonce}" FontWeight="Bold" 
                            Click="BtnRetour_Click"/>

                    <!-- Reprendre : Action principale très claire en Vert StatutActif -->
                    <Button Grid.Column="1" Content="Reprendre là où j'en étais" HorizontalAlignment="Left"
                            Height="42" Width="200" Background="{StaticResource StatutActif}" Foreground="White" FontWeight="Bold" BorderThickness="0" 
                            Click="BtnVersEtape_Click" Margin="135,0,0,0"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
