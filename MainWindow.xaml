<Window x:Class="Ostinato_lab.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Ostinato_lab"
        mc:Ignorable="d"
        Title="MainWindow" Height="650" Width="950">

    <Grid Background="#F5F5F5">
        <!-- Division de l'écran en deux colonnes équitables -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- COLONNE GAUCHE : Zone de calme visuel -->
        <Border Grid.Column="0" Background="#E0E0E0" CornerRadius="10" Margin="20">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <!-- Emplacement du logo Ostinato -->
                <Rectangle Width="100" Height="100" Fill="#888888" Margin="10"/>
                <TextBlock Text="[ LOGO OSTINATO ]" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#333333" FontSize="16"/>
                <TextBlock Text="Votre espace d'apprentissage sans distraction" Margin="0,20,0,0" Foreground="#555555" HorizontalAlignment="Center" FontSize="14"/>
            </StackPanel>
        </Border>

        <!-- COLONNE DROITE : Formulaire sécurisant -->
        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Width="320" Margin="40,0,0,0">
            <TextBlock Text="Connexion" FontSize="26" FontWeight="Bold" Margin="0,0,0,25"/>

            <!-- Sélecteur de profil pour rassurer l'utilisateur (Besoin TDAH : clarté immédiate) -->
            <TextBlock Text="Je suis :" Margin="0,0,0,5" Foreground="#555555" FontWeight="Bold"/>
            <ComboBox Height="35" Margin="0,0,0,20" VerticalContentAlignment="Center" Background="White">
                <ComboBoxItem Content="Un apprenant" IsSelected="True"/>
                <ComboBoxItem Content="Un formateur"/>
                <ComboBoxItem Content="Un administrateur"/>
            </ComboBox>

            <!-- Champ Identifiant -->
            <TextBlock Text="Identifiant ou Email :" Margin="0,0,0,5" Foreground="#555555"/>
            <TextBox Height="35" Background="White" BorderBrush="#888888" BorderThickness="1" VerticalContentAlignment="Center" Margin="0,0,0,15"/>

            <!-- Champ Mot de passe -->
            <TextBlock Text="Mot de passe :" Margin="0,0,0,5" Foreground="#555555"/>
            <PasswordBox Height="35" Background="White" BorderBrush="#888888" BorderThickness="1" VerticalContentAlignment="Center" Margin="0,0,0,25"/>

            <!-- Bouton large, facile à cibler sans stress -->
            <Button Content="Entrer dans mon espace" Height="42" Background="#A0A0A0" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="BtnConnexion_Click"/>

        </StackPanel>
    </Grid>
</Window>
