<Window x:Class="Ostinato_lab.PageMessagerie"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Messagerie" Height="650" Width="950"
        Background="White"
        WindowStartupLocation="CenterScreen">

    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== NAV LATERALE ===== -->
        <Border Grid.Column="0" Background="#D9D9D9">
            <StackPanel Margin="0,20,0,0">
                <TextBlock Text="[ Mon Espace ]" FontWeight="Bold" FontSize="16"
                           Margin="20,0,0,20"/>

                <Button Content="Tableau de bord" Height="40" Margin="10,5"
                        Background="#BFBFBF" BorderThickness="0"/>
                <Button Content="Ma Formation" Height="40" Margin="10,5"
                        Background="#BFBFBF" BorderThickness="0"/>
                <Button Content="Mes Jalons" Height="40" Margin="10,5"
                        Background="#BFBFBF" BorderThickness="0"/>
                <Button Content="Messagerie" Height="40" Margin="10,5"
                        Background="#A6A6A6" BorderThickness="0" FontWeight="Bold"/>

                <Button Content="Déconnexion" Height="40" Margin="10,300,10,5"
                        Background="#BFBFBF" BorderThickness="0"/>
            </StackPanel>
        </Border>

        <!-- ===== CONTENU PRINCIPAL ===== -->
        <Grid Grid.Column="1" Background="#F5F5F5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Titre -->
            <StackPanel Grid.Row="0" Margin="30,25,30,10">
                <TextBlock Text="Messagerie" FontSize="24" FontWeight="Bold"/>
                <TextBlock Text="Conversation avec [ NOM DU FORMATEUR ]" FontSize="13"
                           Foreground="#666666" Margin="0,4,0,0"/>
                <Separator Background="#CCCCCC" Margin="0,15,0,0"/>
            </StackPanel>

            <!-- Fil de conversation -->
            <ScrollViewer Grid.Row="1" Margin="30,0,30,10" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- Message reçu (formateur) -->
                    <StackPanel HorizontalAlignment="Left" Margin="0,0,0,12" MaxWidth="500">
                        <TextBlock Text="Formateur — 14:02" FontSize="11" Foreground="#999999" Margin="4,0,0,4"/>
                        <Border Background="#E0E0E0" CornerRadius="8" Padding="12">
                            <TextBlock Text="[ Message reçu du formateur ]" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>

                    <!-- Message envoyé (apprenant) -->
                    <StackPanel HorizontalAlignment="Right" Margin="0,0,0,12" MaxWidth="500">
                        <TextBlock Text="Vous — 14:10" FontSize="11" Foreground="#999999"
                                   HorizontalAlignment="Right" Margin="0,0,4,4"/>
                        <Border Background="#808080" CornerRadius="8" Padding="12">
                            <TextBlock Text="[ Message envoyé par l'apprenant ]" TextWrapping="Wrap"
                                       Foreground="White"/>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- Zone de saisie -->
            <Grid Grid.Row="2" Margin="30,0,30,25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White" BorderBrush="#CCCCCC"
                        BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,10,0">
                    <TextBlock Text="[ Écrire un message... ]" Foreground="#999999"/>
                </Border>

                <Button Grid.Column="1" Content="Envoyer" Width="100" Height="40"
                        Background="#808080" Foreground="White" BorderThickness="0" FontWeight="Bold"/>
            </Grid>

        </Grid>
    </Grid>
</Window>